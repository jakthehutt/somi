# ============================================================
# blockd — required environment variables
# ============================================================
# Copy this file to .env and fill in the real values.
# .env is gitignored; never commit secrets.
# Note: the parser tolerates spaces around "=", but the cleanest
# form is KEY=value with no spaces.
# ============================================================

# --- Frontend (Vite — these are baked into the browser bundle) ---
# The anon key is public (it identifies unauthenticated requests);
# the URL is not a secret either. Still, changes need a rebuild.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase anon key>

# --- Supabase CLI (for local migrations + function deploys) ---
SUPABASE_ACCESS_TOKEN=<personal access token from supabase.com/dashboard/account/tokens>
SUPABASE_SERVICE_ROLE_KEY=<secret — never expose to browser>

# --- NextDNS (used by the sync-nextdns edge function only) ---
NEXTDNS_PROFILE_ID=<profile ID, e.g. ab12cd3>
NEXTDNS_API_KEY=<API key from my.nextdns.io/account>
